<?xml version="1.0" encoding="UTF-8"?>
<!--
  Patterns that only flag how Spring and Lombok are meant to be used:
  components get their collaborators through the constructor and entities
  hand out their fields, both on purpose.
-->
<FindBugsFilter>
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
</FindBugsFilter>
